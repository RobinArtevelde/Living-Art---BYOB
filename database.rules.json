{
  "rules": {
    "schilderij": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isString() && newData.val().matches(/^[a-z0-9-]{1,20}$/)"
    },
    "mannetjes": {
      ".read": true,
      ".indexOn": [
        "tijdstip"
      ],
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['naam', 'type', 'tijdstip'])",
        "naam": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
        },
        "type": {
          ".validate": "newData.isString() && newData.val().matches(/^(samengesteld|tekening)$/)"
        },
        "tijdstip": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "onderdelen": {
          "$deel": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          }
        },
        "tekening": {
          ".validate": "newData.isString() && newData.val().beginsWith('data:image/png;base64,') && newData.val().length < 200000"
        },
        "$ander": {
          ".validate": false
        }
      }
    },
    "acties": {
      ".read": true,
      ".indexOn": [
        "tijdstip"
      ],
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['mannetje', 'actie', 'tijdstip'])",
        "mannetje": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "actie": {
          ".validate": "newData.isString() && newData.val().matches(/^[a-z-]{1,20}$/)"
        },
        "tijdstip": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "$ander": {
          ".validate": false
        }
      }
    }
  }
}